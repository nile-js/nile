{
  "name": "@nilejs/client",
  "version": "1.1.0",
  "type": "module",
  "description": "Standalone, type-safe client for Nile backend framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://nile-js.github.io/nile/",
  "bugs": {
    "url": "https://github.com/nile-js/nile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nile-js/nile.git",
    "directory": "packages/client"
  },
  "author": "Hussein Kizz",
  "license": "MIT",
  "keywords": [
    "nile",
    "client",
    "backend",
    "typescript",
    "type-safe",
    "fetch",
    "result",
    "socket.io",
    "realtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "export": "bun run typecheck && bun run test:run && bun run build"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "socket.io-client": "4.8.4"
  }
}
