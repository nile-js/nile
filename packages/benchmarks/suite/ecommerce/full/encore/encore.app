{
  "lang": "typescript",
  "global_cors": {
    "allow_headers": [
      "Authorization",
      "Content-Type"
    ],
    "expose_headers": [
      "Content-Length"
    ],
    "allow_origins_with_credentials": [
      "https://store.example"
    ],
    "allow_origins_without_credentials": [
      "https://store.example"
    ]
  }
}
