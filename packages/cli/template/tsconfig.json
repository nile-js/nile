{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noEmit": true,
    "types": [
      "bun"
    ]
  },
  "include": [
    "./src/**/*.ts",
    "./drizzle.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data"
  ]
}
