{
  "name": "@nilejs/cli",
  "version": "1.1.0",
  "description": "CLI for scaffolding and generating Nile backend projects",
  "type": "module",
  "bin": {
    "nile": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "homepage": "https://nile-js.github.io/nile/",
  "bugs": {
    "url": "https://github.com/nile-js/nile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nile-js/nile.git",
    "directory": "packages/cli"
  },
  "author": "Hussein Kizz",
  "license": "MIT",
  "keywords": [
    "nile",
    "cli",
    "scaffolding",
    "generator",
    "codegen",
    "backend",
    "typescript",
    "bun",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "export": "bun run typecheck && bun run build && node dist/index.js --version",
    "test": "bun test scripts/schema-contracts.spec.ts"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "json-schema-to-zod": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "typescript": "^5",
    "zod": "4.6.7"
  }
}
