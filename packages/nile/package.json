{
  "name": "@nilejs/nile",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "TypeScript-first, service and actions oriented backend framework",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fp": {
      "types": "./dist/fp.d.ts",
      "import": "./dist/fp.js",
      "require": "./dist/fp.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "SKILL.md"
  ],
  "repository": "git@github.com:nile-js/nile.git",
  "author": "Hussein Kizz",
  "license": "MIT",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "keywords": [
    "framework",
    "backend",
    "api",
    "hono",
    "server",
    "typescript",
    "service",
    "actions",
    "post only",
    "functional programming",
    "rpc",
    "bun",
    "ai-backend"
  ],
  "scripts": {
    "check": "bunx biome check --no-errors-on-unmatched",
    "fix": "bunx biome check --write",
    "test": "bunx vitest",
    "test:run": "bunx vitest run",
    "test:security": "bunx vitest run security/tests",
    "test:bun": "bun test ./scripts/verify-bun-runtime.spec.ts",
    "build": "tsdown",
    "copy-docs": "bash scripts/copy-docs.sh",
    "export": "bun run check && bun run fix && bun run test:run && bun run build && bun run copy-docs",
    "test:pglite": "bun test ./scripts/verify-pglite-v1.spec.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@socket.io/bun-engine": "0.1.2",
    "croner": "10.0.1",
    "hono": "^4.13.13",
    "hono-rate-limiter": "^0.5.4",
    "nanoid": "^6.0.2",
    "pino": "^10.4.0",
    "slang-ts": "^0.1.1",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@electric-sql/pglite": "^0.2.5",
    "@types/bun": "latest",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "0.8.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "7.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "typescript": "^7.0.2"
  }
}
